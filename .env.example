# Google AI Studio API key (free tier). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model used to read the board off a photo (must support image input).
# Default: Gemma 4 31B Instruct, the multimodal member of the Gemma 4
# family, which has a generous free daily quota. Do NOT point this at a
# text-only Gemma 4 variant (e.g. gemma-4-26b-a4b-it) — it can't see images.
GEMINI_VISION_MODEL=gemma-4-31b-it

# Model used to turn the engine's numbers into Japanese commentary.
# Defaults to the same model as GEMINI_VISION_MODEL if unset. This one can
# be text-only since it never receives an image.
# If Gemma's board-reading accuracy isn't good enough, try switching
# GEMINI_VISION_MODEL to "gemini-2.0-flash" (also free tier) without any
# code changes.
GEMINI_TEXT_MODEL=gemma-4-31b-it
