# Google AI Studio API key (free tier). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model used to read the board off a photo (must support image input).
# Default: Gemma 3 27B, which has a generous free daily quota.
GEMINI_VISION_MODEL=gemma-3-27b-it

# Model used to turn the engine's numbers into Japanese commentary.
# Defaults to the same model as GEMINI_VISION_MODEL if unset.
# If Gemma's board-reading accuracy isn't good enough, try switching
# GEMINI_VISION_MODEL to "gemini-2.0-flash" (also free tier) without any
# code changes.
GEMINI_TEXT_MODEL=gemma-3-27b-it
